west target<->aux\n+  #     8-gram overlap stratum (α<0.05); CI excluding 0 rules out verbatim re-exposure\n+  #     (RETRO bpb(α) protocol). Sidecar: runs/<id>/eval_leakage_placebo.json.\n+\n+  # Python RepoBench (thestack cross_doc_link, max_grants=256)\n+  crossdoc.repobench_python.placebo_sep:\n+    run_ids: [run_20260720_063128_690228]\n+    source: {kind: eval, metric_path: \"repobench_python_xdoc_placebo/native\", field: placebo_separation}\n+    expected: 0.1295747930227324\n+    units: nll\n+    note: \"Python RepoBench placebo separation (placebo - cross mean NLL).\"\n+  crossdoc.repobench_python.placebo_sep.ci:\n+    run_ids: [run_20260720_063128_690228]\n+    source: {kind: eval, metric_path: \"repobench_python_xdoc_placebo/native\", field: placebo_separation_ci}\n+    format: {kind: interval, sig_figs: 3}\n+    note: \"Python RepoBench placebo separation 95% bootstrap CI.\"\n+  crossdoc.repobench_python.leakage_lowalpha.delta_nll:\n+    run_ids: [run_20260720_063128_690228]\n+    source: {kind: eval, metric_path: \"repobench_python_leakage/alpha_0.00_0.05\", field: delta_real}\n+    expected: 0.07807492273640258\n+    units: nll\n+    note: \"Python RepoBench cross-doc Δnll in the lowest overlap stratum (α<0.05).\"\n+  crossdoc.repobench_python.leakage_lowalpha.delta_nll.ci:\n+    run_ids: [run_20260720_063128_690228]\n+    source: {kind: eval, metric_path: \"repobench_python_leakage/alpha_0.00_0.05\", field: delta_real_ci}\n+    format: {kind: interval, sig_figs: 3}\n+    note: \"95% bootstrap CI for the α<0.05 Python stratum Δnll.\"\n+  crossdoc.repobench_python.leakage_lowalpha.n:\n+    run_ids: [run_20260720_063128_690228]\n+    source: {kind: eval, metric_path: \"repobench_python_leakage/alpha_0.00_0.05\", field: n}\n+    expected: 191\n+    format: {sig_figs: 0}\n+    note: \"Number of scored pairs in the α<0.05 stratum (Python).\"\n+\n+  # Java RepoBench (thestack cross_doc_link, bfs traversal)\n+  crossdoc.repobench_java.bfs.placebo_sep:\n+    run_ids: [run_20260722_063905_465684]\n+    source: {kind: eval, metric_path: \"repobench_java_xdoc_placebo/native\", field: placebo_separation}\n+    expected: 0.07738205790519714\n+    units: nll\n+    note: \"Java RepoBench (bfs) placebo separation.\"\n+  crossdoc.repobench_java.bfs.placebo_sep.ci:\n+    run_ids: [run_20260722_063905_465684]\n+    source: {kind: eval, metric_path: \"repobench_java_xdoc_placebo/native\", field: placebo_separation_ci}\n+    format: {kind: interval, sig_figs: 3}\n+    note: \"Java RepoBench (bfs) placebo separation 95% bootstrap CI.\"\n+  crossdoc.repobench_java.bfs.leakage_lowalpha.delta_nll:\n+    run_ids: [run_20260722_063905_465684]\n+    source: {kind: eval, metric_path: \"repobench_java_leakage/alpha_0.00_0.05\", field: delta_real}\n+    expected: 0.038774442022497004\n+    units: nll\n+    note: \"Java RepoBench (bfs) cross-doc Δnll in the lowest overlap stratum (α<0.05).\"\n+  crossdoc.repobench_java.bfs.leakage_lowalpha.delta_nll.ci:\n+    run_ids: [run_20260722_063905_465684]\n+    source: {kind: eval, metric_path: \"repobench_java_leakage/alpha_0.00_0.05\", field: delta_real_ci}\n+    format: {kind: interval, sig_figs: 3}\n+    note: \"95% bootstrap CI for the α<0.05 Java stratum Δnll.\"\n+  crossdoc.repobench_java.bfs.leakage_lowalpha.n:\n+    run_ids: [run_20260722_063905_465684]\n+    source: {kind: eval, metric_path: \"repobench_java_leakage/alpha_0.00_0.05\", field: n}\n+    expected: 275\n+    format: {sig_figs: 0}\n+    note: \"Number of scored pairs in the α<0.05 stratum (Java).\"\n+\n+  # Wiki HotpotQA (wiki cross_doc_link, bfs)\n+  crossdoc.wiki_hotpotqa.placebo_sep:\n+    run_ids: [run_20260717_173951_071952]\n+    source: {kind: eval, metric_path: \"hotpotqa_xdoc_placebo/native\", field: placebo_separation}\n+    expected: 1.2762295113225872\n+    units: nll\n+    note: \"HotpotQA placebo separation.\"\n+  crossdoc.wiki_hotpotqa.placebo_sep.ci:\n+    run_ids: [run_20260717_173951_071952]\n+    source: {kind: eval, metric_path: \"hotpotqa_xdoc_placebo/native\", field: placebo_separation_ci}\n+    format: {kind: interval, sig_figs: 3}\n+    note: \"HotpotQA placebo separation 95% bootstrap CI.\"\n+  crossdoc.wiki_hotpotqa.leakage_lowalpha.delta_nll:\n+    run_ids: [run_20260717_173951_071952]\n+    source: {kind: eval, metric_path: \"hotpotqa_leakage/alpha_0.00_0.05\", field: delta_real}\n+    expected: 1.0777658168282753\n+    units: nll\n+    note: \"HotpotQA cross-doc Δnll in the lowest overlap stratum (α<0.05).\"\n+  crossdoc.wiki_hotpotqa.leakage_lowalpha.delta_nll.ci:\n+    run_ids: [run_20260717_173951_071952]\n+    source: {kind: eval, metric_path: \"hotpotqa_leakage/alpha_0.00_0.05\", field: delta_real_ci}\n+    format: {kind: interval, sig_figs: 3}\n+    note: \"95% bootstrap CI for the α<0.05 HotpotQA stratum Δnll.\"\n+  crossdoc.wiki_hotpotqa.leakage_lowalpha.n:\n+    run_ids: [run_20260717_173951_071952]\n+    source: {kind: eval, metric_path: \"hotpotqa_leakage/alpha_0.00_0.05\", field: n}\n+    expected: 662\n+    format: {sig_figs: 0}\n+    note: \"Number of scored pairs in the α<0.05 stratum (HotpotQA).\"\n+\n+  # === Graph-sparsity scaling law: cross-dataset regression (LITERAL / grounding debt) ===\n+  # This is a CROSS-RUN analysis fit (Pearson r over many (dataset, keep) points), not a\n+  # single run's eval metric, so it cannot be eval-grounded. Value is emitted by\n+  # eval/viz/regress_density.py into sparsity_scaling/regression.json. run_ids list the code\n+  # solo cross_doc endpoints the fit pools over (ts/thestack/rust/dart/js). Δnll points\n+  # themselves live in sparsity_scaling/{phase1_eval,phase2_traintime,grid2d}/*.json.\n+  sparsity.crossdoc_law.eval_r_code:\n+    run_ids: [run_20260723_044101_595472, run_20260721_225606_146404, run_20260722_172826_905950, run_20260722_172933_276517, run_20260720_063128_690228]\n+    source: {kind: literal, value: 0.9539707664761473}\n+    format: {sig_figs: 2}\n+    note: \"Pearson r of cross-doc Δnll@full-density vs effective grants/pack, CODE datasets,\n+      EVAL-time (n=36). From sparsity_scaling/regression.json (evaltime.code.r), produced by\n+      eval/viz/regress_density.py. Cross-run analysis fit, not a per-run eval metric → literal\n+      grounding debt; re-derivable by rerunning regress_density.py on the sparsity_scaling data.\""},"type":"user","userType":"external","uuid":"340fe9e8-be1a-487f-995d-de84dc03aaa0","version":"2.1.252"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-09-01T17:18:33.250Z","schema":"annals/v1","stream":{"id":"claude-code:5cbbe416-90e8-4a21-93e7-044acf862880","seq":585}}
{"content":{"blocks":[{"content":"diff --git a/paper/sections/06_results.tex b/paper/sections/06_results.tex\nindex 57e5d33..1435bfc 100644\n--- a/paper/sections/06_results.tex\n+++ b/paper/sections/06_results.tex\n@@ -18,6 +18,35 @@ traversals --- from \\val{crossdoc.repobench_java.random.delta_nll} (random packi\n (dfs) in between --- and Python RepoBench cross-doc shows a $\\Delta$nll of\n \\val{crossdoc.repobench_python.delta_nll} (max\\_grants=256).\n \n+\\subsection{The cross-document gain is specific, not memorization}\n+Two controls confirm the reduction above comes from reading the \\emph{correct} linked\n+document, not from generic extra context or verbatim re-exposure of overlapping text.\n+First, a derangement \\emph{placebo}: for each query we keep the original link identifiers\n+(so the grant still fires) but replace the granted document's content with another\n+example's, so the model attends to a wrong-but-plausible document. This collapses most of\n+the benefit, leaving a placebo separation (placebo minus cross-document NLL) of\n+\\val{crossdoc.wiki_hotpotqa.placebo_sep} (95\\% CI\n+\\val{crossdoc.wiki_hotpotqa.placebo_sep.ci}) on HotpotQA, and\n+\\val{crossdoc.repobench_python.placebo_sep}\n+(\\val{crossdoc.repobench_python.placebo_sep.ci}) and\n+\\val{crossdoc.repobench_java.bfs.placebo_sep}\n+(\\val{crossdoc.repobench_java.bfs.placebo_sep.ci}) on Python and Java RepoBench --- all\n+CIs excluding zero. Second, we stratify the cross-document $\\Delta$nll by the\n+target--context $n$-gram overlap $\\alpha$ (RETRO's leakage protocol): even in the\n+lowest-overlap stratum ($\\alpha<0.05$), where the target cannot be copied from the granted\n+context, the reduction persists at\n+\\val{crossdoc.wiki_hotpotqa.leakage_lowalpha.delta_nll}\n+(\\val{crossdoc.wiki_hotpotqa.leakage_lowalpha.delta_nll.ci},\n+$n=\\val{crossdoc.wiki_hotpotqa.leakage_lowalpha.n}$) on HotpotQA,\n+\\val{crossdoc.repobench_python.leakage_lowalpha.delta_nll}\n+(\\val{crossdoc.repobench_python.leakage_lowalpha.delta_nll.ci},\n+$n=\\val{crossdoc.repobench_python.leakage_lowalpha.n}$) on Python, and\n+\\val{crossdoc.repobench_java.bfs.leakage_lowalpha.delta_nll}\n+(\\val{crossdoc.repobench_java.bfs.leakage_lowalpha.delta_nll.ci},\n+$n=\\val{crossdoc.repobench_java.bfs.leakage_lowalpha.n}$) on Java --- again all CIs\n+excluding zero. The gain therefore reflects cross-document reasoning over the right link,\n+not surface duplication.\n+\n \\subsection{Single-document benchmarks are unaffected}\n Across the single-document controls (HellaSwag, ARC-easy, PIQA, WinoGrande, OpenBookQA,\n BoolQ), the four masks are statistically indistinguishable. On HellaSwag the matched\n@@ -68,3 +97,65 @@ step-time \\fillin{speedup/slowdown?}, with per-bucket coefficient-of-variation\n % Wall-clock timing (step_timing_rank*.csv), not the eval harness. Raw CSVs are not located\n % in-repo and carry no run_id; only README.md prose + docs/images/density_aware_timing*.png\n % survive. Indicative only until the originating run + its CSVs are identified.\n+\n+\\subsection{Graph-sparsity scaling law}\n+\\label{sec:sparsity}\n+We interpolate the fraction of resolved links a model sees, from $0\\%$ (\\doccausal)\n+to $100\\%$ (\\crossdoc), by seeded per-edge subsampling of the grant map, and measure\n+the within-model cross-doc benefit $\\Delta\\mathrm{nll} =\n+\\mathrm{nll}(\\doccausal)-\\mathrm{nll}(\\crossdoc)$ on each dataset's\n+\\texttt{val\\_community} split. We do this both at eval time (fix a trained model, vary\n+the links it attends to; \\cref{fig:sparsity-eval}) and at train time (retrain on the\n+reduced graph; \\cref{fig:sparsity-train}), and cross the two axes into a surface\n+(\\cref{fig:sparsity-grid}).\n+\n+\\begin{figure}[t]\n+  \\centering\n+  \\includegraphics[width=\\linewidth]{fig_sparsity.png}\n+  \\caption{Eval-time graph-sparsity law. Panel A: $\\Delta$nll vs kept link fraction\n+  per dataset (blue = code, orange = text; band = seeds 0--2). Panel B: cross-dataset\n+  law --- $\\Delta$nll at full density vs the effective co-packed grant density the mask\n+  actually saw.}\n+  \\label{fig:sparsity-eval}\n+\\end{figure}\n+\n+\\begin{figure}[t]\n+  \\centering\n+  \\includegraphics[width=\\linewidth]{fig_traintime.png}\n+  \\caption{Train-time graph-sparsity law: models retrained at each link density\n+  (solid) overlaid on the eval-time curve (dashed) for the same datasets.}\n+  \\label{fig:sparsity-train}\n+\\end{figure}\n+\n+\\begin{figure}[t]\n+  \\centering\n+  \\includegraphics[width=\\linewidth]{fig_grid2d.png}\n+  \\caption{Cross-doc benefit $\\Delta$nll over the full (train keep $\\times$ eval keep)\n+  grid, per dataset. Rows = training-graph density, columns = inference-graph density;\n+  keep${=}0$ column is the \\doccausal identity ($\\Delta{=}0$).}\n+  \\label{fig:sparsity-grid}\n+\\end{figure}\n+\n+\\begin{itemize}\n+  \\item \\textbf{\\cref{fig:sparsity-eval} (eval-time lines + cross-dataset law).} How a\n+  fixed trained model's cross-doc benefit grows as it is allowed to attend to more of\n+  the graph's links. \\emph{Meaning:} for code the benefit rises near-linearly with\n+  effective link density and the cross-dataset fit is strong ($r{=}\\val{sparsity.crossdoc_law.eval_r_code}$), so it\n+  extrapolates \\emph{above} today's densest corpus; the honest density axis is\n+  effective co-packed grants/pack, not raw out-degree. Text (wiki, arxiv) is flat or\n+  slightly negative.\n+  \\item \\textbf{\\cref{fig:sparsity-train} (train-time lines).} The same sweep but\n+  \\emph{retraining} at each density, so the model learns under the sparsity it is\n+  given. \\emph{Meaning:} the code curves are monotone but strongly concave --- most of\n+  the benefit is captured by the first ${\\sim}25\\%$ of links (diminishing returns to\n+  training density) --- and sit at or above the eval-time curve at low density.\n+  \\item \\textbf{\\cref{fig:sparsity-grid} (2D train\\,$\\times$\\,eval surface).} The\n+  headline result: the dominant gradient is \\emph{horizontal} (eval keep), not vertical\n+  (train keep). \\emph{Meaning:} the cross-doc payoff is overwhelmingly an\n+  \\emph{inference-time} capability --- a \\doccausal-trained code model (bottom row)\n+  exploits cross-doc links at test time as well as, or better than, one trained with\n+  them, so having linked content in context at inference matters far more than\n+  training-time exposure. Wiki is the lone net-negative (blue) panel, and there\n+  \\emph{training} on cross-doc links makes it worse while a \\doccausal wiki model is\n+  barely affected.\n+\\end{itemize}\ndiff --git a/paper/sections/07_analysis.tex b/paper/sections/07_analysis.tex\nindex f189090..165a4e2 100644\n--- a/paper/sections/07_analysis.tex\n+++ b/paper/sections/07_analysis.tex\n@@ -7,3 +7,12 @@ more local/predictable than Wikipedia bridge reasoning. community\\_pack\n \\fillin{near-noise?} for code. Limitations: undertrained regime, scale ceiling,\n single-language benchmark coverage gaps (only Python/Java have RepoBench). Honest\n framing of the flat scaling.}\n+\n+\\paragraph{The effect is a genuine linking bias.}\n+The placebo and leakage controls (Section~\\ref{sec:results}) rule out the two deflationary\n+readings of the cross-document $\\Delta$nll. The derangement placebo removes almost all of\n+the gain while holding the amount of granted context fixed, so the benefit is specificity\n+to the correct linked document, not generic extra context; and the reduction persists in\n+the lowest $n$-gram-overlap stratum, so it is not verbatim copying of duplicated text. What\n+remains is the intended inductive bias: attention gated onto the right cross-document\n+target at generation time.","is_error":false,"tool_use_id":"toolu_01NRVkJ8dZRoQ1DyhYX638MW","type":"tool_result"}],"role":"user"},"context":{"branch":"paper-prose-draft","cwd":"/Users/evintunador/repos/evintunador/tagseq2tagseq","head":"66ae5bc942464f47e6398e0ac64d929a2aa9663f","repo":"gi
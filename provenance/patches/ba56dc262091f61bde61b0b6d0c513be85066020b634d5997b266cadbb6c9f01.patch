+# Generated from configs/wiki_merged_doc_causal.yaml.
+data:
+  dataset_dir: /fss-data/evin_t/tagseq2tagseq_artifacts/pretokenized_datasets/wiki_merged
+  strategy: 'random'
+  layout_policy: 'stochastic_identifier_prefix'
+  inference_layout_policy: 'eos'
+  order_mode: 'prefer_targets_first'
+  doc_budget: null
+  train_dir:   /fss-data/evin_t/tagseq2tagseq_artifacts/pretokenized_datasets/wiki_merged/splits/train
+  epoch_dirs: [/fss-data/evin_t/tagseq2tagseq_artifacts/schedules/wiki_merged_random/epoch_0,/fss-data/evin_t/tagseq2tagseq_artifacts/schedules/wiki_merged_random/epoch_1,/fss-data/evin_t/tagseq2tagseq_artifacts/schedules/wiki_merged_random/epoch_2,/fss-data/evin_t/tagseq2tagseq_artifacts/schedules/wiki_merged_random/epoch_3]
+  val_dirs:
+    val_community: /fss-data/evin_t/tagseq2tagseq_artifacts/pretokenized_datasets/wiki_merged/splits/val_community
+    val_random:    /fss-data/evin_t/tagseq2tagseq_artifacts/pretokenized_datasets/wiki_merged/splits/val_random
+  test_dirs:
+    test_community: /fss-data/evin_t/tagseq2tagseq_artifacts/pretokenized_datasets/wiki_merged/splits/test_community
+    test_random:    /fss-data/evin_t/tagseq2tagseq_artifacts/pretokenized_datasets/wiki_merged/splits/test_random
+
+model:
+  compile: true
+  compile_mode: 'default'
+  attention_backend: 'triton'
+  inference_attention_backend: 'flex'
+  mask_type: 'doc_causal'
+  activation_checkpointing: false
+  model_dim: 1024
+  num_layers: 24
+  num_heads: 8    # 8H × 128Dh = 1024
+  max_seq_len: 32768
+  drop_path_rate: 0.0
+  fp8: false
+  weight_tying: true
+  untie_at_frac: 0.667       # release embed/lm_head tie at 2/3 of training
+  ignore_index: -100
+  dtype: 'bfloat16'
+  logit_softcap: 30.0
+  mtp_extra_weights: [0.5, 0.25]
+  mtp_decay_steps: 0
+  ve_layers: []            # VE banks OFF: 258M params removed to match 1.36B-tok corpus
+  shared_ve_bank: false
+  # use_bigram: false
+  # bigram_vocab_size: 251520
+
+optimizer:
+  type: 'muon'
+  muon_wd: 0.1             # WD SWEEP (low extension)
+  adamw_wd: 0.005          # AdamW weight decay (embeddings, norms)
+  momentum: 0.95
+  muon_beta2: 0.95         # NorMuon second-moment EMA
+  beta1: 0.9
+  beta2: 0.95
+  muon_lr: 0.003
+  adamw_lr: 3e-05
+  muon_momentum_warmup_steps: 300
+  adamw_embed_beta1: 0.5   # lower β1 for embedding/lm_head (sparse gradients)
+
+train_loop:
+  epochs: 1
+  max_optimizer_steps: null  # AUTO-DERIVED from 4 epoch_dirs (~14456 steps @ world=8); enables cooldown+untie
+  warmup_steps: 300
+  cooldown_frac: 0.4
+  min_lr_ratio: 0.1
+  val_steps: 20
+  val_interval: 250
+  # Overwrite a single latest.pt every N optimizer steps (independent of val)

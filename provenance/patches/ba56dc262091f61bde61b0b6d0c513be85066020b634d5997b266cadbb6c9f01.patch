diff --git a/RESULTS.md b/RESULTS.md
index c79b961..1b119ff 100644
--- a/RESULTS.md
+++ b/RESULTS.md
@@ -29,8 +29,32 @@ Winner (muon_lr=0.003, fully trained to step 14438, `doceval`, max_docs=1000):
 First wiki model **statistically above chance** (hellaswag + arc_easy) — the old
 ablation was indistinguishable from chance on everything. Config: 1024d/24L/8H,
 `ve_layers: []`, `weight_tying:true` + `untie_at_frac:0.667`, cooldown_frac 0.4,
-min_lr_ratio 0.1. Run dir `runs/20260715_232111...` (job 45065). Pending: seed-43
-replica + doc_concatenated LR-transfer confirm; then a weight-decay sweep at 0.003.
+min_lr_ratio 0.1. Run dir `runs/20260715_232111...` (job 45065).
+
+**Follow-on tuning (2026-07-18):** weight-decay sweep found `muon_wd=1.2` (inherited)
+was ~12× too high — clean U-curve minimum at **muon_wd=0.1** (val 2.424 vs 2.548 @1.2).
+LR optimum stayed 0.003 across WD. Final tuned config: **muon_lr=0.003, muon_wd=0.1,
+VE-off**. wd=0.1 winner re-eval: ppl **3.75**, arc_easy 0.368, hellaswag 0.322.
+
+## CROSS-DOC THESIS CONFIRMED (2026-07-18) — the core result
+
+`hotpotqa_cross_doc` on the tuned **cross_doc_link** wiki model (bfs, run 45314) scores
+the same 2-hop questions two ways:
+
+| condition | mean NLL | perplexity |
+|-----------|:--------:|:----------:|
+| **cross-doc** (linked doc via cross-doc attention) | **5.63** | **278** |
+| flat-linked (same content concatenated, no cross-doc structure) | 6.92 | 1012 |
+
+**Δnll = +1.29 (~19% lower NLL, 3.6× lower perplexity) favoring cross-doc attention**
+(n=738). This is the project's central mechanism, confirmed at a properly-tuned
+operating point (the old undertrained run showed only +13.4%). On single-doc
+benchmarks all masks are ~identical (doc_causal / cross_doc_link / doc_concat_link
+all ppl≈3.84, hellaswag≈0.33) — the cross-doc advantage appears **only** on the
+multi-hop cross-doc benchmark, exactly as the hypothesis predicts.
+
+In progress: traversal ablation (cross_doc_link on dfs / random_walk / bfs — does
+traversal order change the cross-doc Δnll?); arxiv sweep (VE converging on 38B tok).
 
 ---
 

diff --git a/configs/wiki_crossdoc_dfs.yaml b/configs/wiki_crossdoc_dfs.yaml
new file mode 100644
index 0000000..1234567
--- /dev/null
+++ b/configs/wiki_crossdoc_dfs.yaml
@@ -0,0 +1,100 @@
+# TRAVERSAL ABLATION — cross_doc_link on dfs (LR0.003/wd0.3/VE-off, 4-epoch).
+# muon_lr=0.003, adamw_lr=3e-05. Goal: monotonic loss + above-chance benchmarks.
+# Generated from configs/wiki_merged_doc_causal.yaml.
+data:
+  dataset_dir: /fss-data/evin_t/tagseq2tagseq_artifacts/pretokenized_datasets/wiki_merged
+  strategy: 'dfs'
+  layout_policy: 'stochastic_identifier_prefix'
+  inference_layout_policy: 'eos'
+  order_mode: 'prefer_targets_first'
+  doc_budget: null
+  train_dir:   /fss-data/evin_t/tagseq2tagseq_artifacts/pretokenized_datasets/wiki_merged/splits/train
+  epoch_dirs:  [/fss-data/evin_t/tagseq2tagseq_artifacts/schedules/wiki_merged_dfs/epoch_0,/fss-data/evin_t/tagseq2tagseq_artifacts/schedules/wiki_merged_dfs/epoch_1,/fss-data/evin_t/tagseq2tagseq_artifacts/schedules/wiki_merged_dfs/epoch_2,/fss-data/evin_t/tagseq2tagseq_artifacts/schedules/wiki_merged_dfs/epoch_3]
+  val_dirs:
+    val_community: /fss-data/evin_t/tagseq2tagseq_artifacts/pretokenized_datasets/wiki_merged/splits/val_community
+    val_random:    /fss-data/evin_t/tagseq2tagseq_artifacts/pretokenized_datasets/wiki_merged/splits/val_random
+  test_dirs:
+    test_community: /fss-data/evin_t/tagseq2tagseq_artifacts/pretokenized_datasets/wiki_merged/splits/test_community
+    test_random:    /fss-data/evin_t/tagseq2tagseq_artifacts/pretokenized_datasets/wiki_merged/splits/test_random
+
+model:
+  compile: true
+  compile_mode: 'default'
+  attention_backend: 'triton'
+  inference_attention_backend: 'flex'
+  mask_type: 'cross_doc_link'
+  link_detector: 'markdown'
+  max_grants: 256
+  activation_checkpointing: false
+  model_dim: 1024
+  num_layers: 24
+  num_heads: 8    # 8H × 128Dh = 1024
+  max_seq_len: 32768
+  drop_path_rate: 0.0
+  fp8: false
+  weight_tying: true
+  untie_at_frac: 0.667       # release embed/lm_head tie at 2/3 of training
+  ignore_index: -100
+  dtype: 'bfloat16'
+  logit_softcap: 30.0
+  mtp_extra_weights: [0.5, 0.25]
+  mtp_decay_steps: 0
+  ve_layers: []            # VE banks OFF: 258M params removed to match 1.36B-tok corpus
+  shared_ve_bank: false
+  # use_bigram: false
+  # bigram_vocab_size: 251520
+
+optimizer:
+  type: 'muon'
+  muon_wd: 0.3             # WD SWEEP
+  adamw_wd: 0.005          # AdamW weight decay (embeddings, norms)
+  momentum: 0.95
+  muon_beta2: 0.95         # NorMuon second-moment EMA
+  beta1: 0.9
+  beta2: 0.95
+  muon_lr: 0.003
+  adamw_lr: 3e-05
+  muon_momentum_warmup_steps: 300
+  adamw_embed_beta1: 0.5   # lower β1 for embedding/lm_head (sparse gradients)
+
+train_loop:
+  epochs: 1
+  max_optimizer_steps: null  # AUTO-DERIVED from 4 epoch_dirs (~14456 steps @ world=8); enables cooldown+untie
+  warmup_steps: 300
+  cooldown_frac: 0.4
+  min_lr_ratio: 0.1
+  val_steps: 20
+  val_interval: 250
+  # Overwrite a single latest.pt every N optimizer steps (independent of val)
+  # so a kill/preemption loses at most N steps. Set to val_interval here.
+  # latest.pt embeds full optimizer state (>model size) — written to /fss-data
+  # each time; resume with --resume-from <run>/checkpoints/latest.pt (or best_model.pt).
+  save_latest_interval: 250
+  atomic_feature_kwargs:
+    norm_clip_value: 1.0
+    accum_steps: 1
+
+seed: 42
+
+eval:
+  run_on_completion: true
+  benchmarks:
+    - {name: held_out_perplexity,       conditions: [doceval]}
+    - {name: community_pack_perplexity, conditions: [doceval]}
+    - {name: wiki_qa,     conditions: [doceval]}
+    - {name: hellaswag,   conditions: [doceval]}
+    - {name: boolq,       conditions: [doceval]}
+    - {name: openbookqa,  conditions: [doceval]}
+    - {name: hotpotqa,    conditions: [doceval]}
+  max_docs: 500
+  annotator_corpus: /fss-data/evin_t/tagseq2tagseq_artifacts/pretokenized_datasets/wiki_merged
+  annotator_mode: corpus_only
+  annotator_strategies: [exact, norm, word_overlap_ordered]
+
+# --- Smoke-test overrides (pass on CLI, don't edit here) ---
+# --model.model_dim 256 --model.num_layers 4 --model.num_heads 4
+# --model.max_seq_len 2048
+# --model.mtp_extra_weights '[]' --model.ve_layers '[]'
+# --train_loop.max_optimizer_steps 5 --train_loop.val_steps 2 --train_loop.val_interval 3
+# --eval.max_docs 20
+


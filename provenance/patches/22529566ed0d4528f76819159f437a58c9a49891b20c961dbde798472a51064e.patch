diff --git a/scripts/sweep_yield_watcher.sh b/scripts/sweep_yield_watcher.sh
index 8e20f2d..d77ebdf 100755
--- a/scripts/sweep_yield_watcher.sh
+++ b/scripts/sweep_yield_watcher.sh
@@ -232,6 +232,31 @@ job_to_rundir_config() {
   printf '%s\t%s\n' "$rundir" "$cfg"
 }
 
+# Extract the ORIGINAL run's main.py args to REPLAY on resume, EXCLUDING the
+# launcher-managed ones (--config, --resume-from) which are supplied separately.
+# Without this, ad-hoc CLI overrides (e.g. --data.epoch_dirs pointing at a
+# subsampled graph-sparsity schedule) are silently dropped on auto-resume, so the
+# job reloads its checkpoint but trains on the CONFIG's baked (wrong) data — a
+# corrupted hybrid. See memory [[sparsity-watcher-resume-bug]]. Backward-compatible:
+# a run launched with only --config yields no extra args (identical old behavior).
+extra_main_args() {
+  local rundir="$1"
+  local inv; inv="$(find "$rundir/reproducibility" -name run_invocation.json 2>/dev/null | head -1)"
+  [ -z "$inv" ] && return 0
+  python3 - "$inv" <<'PYEOF' 2>/dev/null
+import json, sys, shlex
+argv = json.load(open(sys.argv[1]))["argv"]
+# argv[0] is "main"; drop it. Strip --config VALUE and --resume-from VALUE.
+out, i = [], 1
+while i < len(argv):
+    a = argv[i]
+    if a in ("--config", "--resume-from"):
+        i += 2; continue
+    out.append(a); i += 1
+print(" ".join(shlex.quote(x) for x in out))
+PYEOF
+}
+
 # Relaunch one yielded job on a given clean node, resuming if a checkpoint exists.
 relaunch_yielded() {
   local rundir="$1" cfg="$2" node="$3"
@@ -239,11 +264,14 @@ relaunch_yielded() {
   local ck="$rundir/checkpoints/latest.pt"
   local resume_args=""
   if [ -f "$ck" ]; then resume_args="--resume-from $ck"; fi
+  # Replay the original invocation's extra overrides (e.g. --data.epoch_dirs) so
+  # resume trains on the SAME data the run was launched with, not the config default.
+  local extra; extra="$(extra_main_args "$rundir")"
   local tag; tag="$(basename "$cfg" .yaml)"
-  note "  RELAUNCH $tag on $node $([ -n "$resume_args" ] && echo "(resume from $(basename "$rundir"))" || echo "(fresh — no ckpt)")"
+  note "  RELAUNCH $tag on $node $([ -n "$resume_args" ] && echo "(resume from $(basename "$rundir"))" || echo "(fresh — no ckpt)")$([ -n "$extra" ] && echo " [+overrides: $extra]")"
   TS2TS_SHARED_COMPILE_CACHE="/tmp/ts2ts_relaunch_$(basename "$rundir")" \
     "$REPO/.venv/bin/python" "$REPO/launch_slurm.py" --nodes 1 --gpus-per-node 8 \
-    --nodelist "$node" --config "$cfg" --time 96:00:00 --no-tail $resume_args \
+    --nodelist "$node" --config "$cfg" --time 96:00:00 --no-tail $resume_args $extra \
     >> "$STATE_DIR/relaunch.log" 2>&1
 }
 

diff --git a/configs/sparsity/dart_keep0p25_cdl.yaml b/configs/sparsity/dart_keep0p25_cdl.yaml
new file mode 100644
index 0000000..1234567
--- /dev/null
+++ b/configs/sparsity/dart_keep0p25_cdl.yaml
@@ -0,0 +1,81 @@
+# GRAPH-SPARSITY dart keep=0p25 — subsampled epoch_dirs baked in (resume-safe).
+# Derived from configs/dart_sweep/dart_veoff_cdl.yaml; ONLY epoch_dirs changed (→ keep0p25, 9 epoch(s)).
+# DART SWEEP — mask=cross_doc_link. Wiki-tuned recipe (muon_lr=0.003, muon_wd=0.1, VE-off).
+# dart 9 epoch_dirs cover max_optimizer_steps=15000 @ world=8 (~chinchilla).
+data:
+  dataset_dir: /fss-data/evin_t/tagseq2tagseq_artifacts/pretokenized_datasets/dart
+  strategy: 'bfs'
+  layout_policy: 'stochastic_slash_comment_prefix'
+  inference_layout_policy: 'slash_comment_prefix_eos'
+  order_mode: 'prefer_targets_first'
+  doc_budget: null
+  train_dir:   /fss-data/evin_t/tagseq2tagseq_artifacts/pretokenized_datasets/dart/splits/train
+  epoch_dirs:  [/fss-data/evin_t/tagseq2tagseq_artifacts/sparsity_scaling/schedules/dart_bfs_keep0p25/epoch_0,/fss-data/evin_t/tagseq2tagseq_artifacts/sparsity_scaling/schedules/dart_bfs_keep0p25/epoch_1,/fss-data/evin_t/tagseq2tagseq_artifacts/sparsity_scaling/schedules/dart_bfs_keep0p25/epoch_2,/fss-data/evin_t/tagseq2tagseq_artifacts/sparsity_scaling/schedules/dart_bfs_keep0p25/epoch_3,/fss-data/evin_t/tagseq2tagseq_artifacts/sparsity_scaling/schedules/dart_bfs_keep0p25/epoch_4,/fss-data/evin_t/tagseq2tagseq_artifacts/sparsity_scaling/schedules/dart_bfs_keep0p25/epoch_5,/fss-data/evin_t/tagseq2tagseq_artifacts/sparsity_scaling/schedules/dart_bfs_keep0p25/epoch_6,/fss-data/evin_t/tagseq2tagseq_artifacts/sparsity_scaling/schedules/dart_bfs_keep0p25/epoch_7,/fss-data/evin_t/tagseq2tagseq_artifacts/sparsity_scaling/schedules/dart_bfs_keep0p25/epoch_8]
+  val_dirs:
+    val_community: /fss-data/evin_t/tagseq2tagseq_artifacts/pretokenized_datasets/dart/splits/val_community
+    val_random:    /fss-data/evin_t/tagseq2tagseq_artifacts/pretokenized_datasets/dart/splits/val_random
+  test_dirs:
+    test_community: /fss-data/evin_t/tagseq2tagseq_artifacts/pretokenized_datasets/dart/splits/test_community
+    test_random:    /fss-data/evin_t/tagseq2tagseq_artifacts/pretokenized_datasets/dart/splits/test_random
+
+model:
+  compile: true
+  compile_mode: 'default'
+  attention_backend: 'triton'
+  inference_attention_backend: 'flex'
+  mask_type: 'cross_doc_link'
+  link_detector: 'dart'
+  max_grants: 256
+  activation_checkpointing: false
+  model_dim: 1024
+  num_layers: 24
+  num_heads: 8    # 8H × 128Dh = 1024
+  max_seq_len: 32768
+  drop_path_rate: 0.0
+  fp8: false
+  weight_tying: true
+  untie_at_frac: 0.667
+  ignore_index: -100
+  dtype: 'bfloat16'
+  logit_softcap: 30.0
+  mtp_extra_weights: [0.5, 0.25]
+  mtp_decay_steps: 0
+  ve_layers: []
+  shared_ve_bank: false
+
+optimizer:
+  type: 'muon'
+  muon_wd: 0.1
+  adamw_wd: 0.005
+  momentum: 0.95
+  muon_beta2: 0.95
+  beta1: 0.9
+  beta2: 0.95
+  muon_lr: 0.003
+  adamw_lr: 3e-05
+  muon_momentum_warmup_steps: 300
+  adamw_embed_beta1: 0.5
+
+train_loop:
+  epochs: 1
+  max_optimizer_steps: 15000  # PINNED to match endpoint schedule (was null/auto-derive -> stretched)
+  warmup_steps: 300
+  cooldown_frac: 0.4
+  min_lr_ratio: 0.1
+  val_steps: 20
+  val_interval: 250
+  save_latest_interval: 250
+  atomic_feature_kwargs:
+    norm_clip_value: 1.0
+    accum_steps: 1
+
+seed: 42
+
+eval:
+  run_on_completion: true
+  benchmarks:
+    - {name: held_out_perplexity,       conditions: [doceval]}
+    - {name: community_pack_perplexity, conditions: [baseline, experimental]}
+  max_docs: 500
+  link_fuzzy_match: false
+


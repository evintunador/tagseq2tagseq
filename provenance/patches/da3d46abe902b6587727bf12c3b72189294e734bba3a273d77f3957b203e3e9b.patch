+"""Tests for fixed-length padding in build_packed_batch.
+
+Padding makes the packed sequence length CONSTANT across packs so the Triton
+attention kernels (which take seq-len as a tl.constexpr ``N``) autotune once
+instead of re-running the ~140s 48-config autotune on every new length — the
+latter desyncs DDP ranks when one draws a short pack (see TODOS.md).
+"""
+import numpy as np
+import torch
+
+from data.collate import build_packed_batch
+from data.pack_sampler import DocPlacement
+
+
+class _MockGraph:
+    def get_normed_identifier(self, doc_id): return f"doc_{doc_id}"
+    def get_raw_identifier(self, nid): return nid
+    def get_outgoing_links(self, nid): return []
+    def get_incoming_links(self, nid): return []
+    def get_categories(self, nid): return ""
+
+
+class _MockBackend:
+    """Returns a distinctive non-pad body so padding is visible."""
+    def __init__(self, body_len=20, fill=7):
+        self.body_len = body_len
+        self.fill = fill
+    def get_tokens_by_id(self, doc_id):
+        return np.full(self.body_len, self.fill, dtype=np.int32)
+
+
+class _NullLayout:
+    def prefix_length(self, info): return 0
+    def suffix_length(self, info): return 0
+    def prefix_tokens(self, info): return []
+    def suffix_tokens(self, info): return []
+
+
+def _build(body_len, pad_to_length, pad_token_id=0):
+    placements = [DocPlacement(doc_id=0, effective_len=body_len, truncated=False, doc_trim_side="tail")]
+    return build_packed_batch(
+        graph=_MockGraph(),
+        backend=_MockBackend(body_len=body_len, fill=7),
+        layout=_NullLayout(),
+        placements=placements,
+        as_2d=True,
+        pad_to_length=pad_to_length,
+        pad_token_id=pad_token_id,
+    )
+
+
+def test_padding_produces_fixed_length():
+    """Different real lengths all pad to the same fixed sequence length."""
+    for body_len in (20, 50, 99):
+        batch = _build(body_len, pad_to_length=128)
+        assert batch["tokens"].shape == (1, 128), batch["tokens"].shape
+        assert batch["n_real_tokens"] == body_len
+
+
+def test_padding_uses_pad_token_and_marks_real_count():
+    batch = _build(body_len=20, pad_to_length=128, pad_token_id=0)
+    toks = batch["tokens"][0]
+    # First 20 are real body (fill=7), remainder is pad (0).
+    assert torch.all(toks[:20] == 7)
+    assert torch.all(toks[20:] == 0)
+    assert batch["n_real_tokens"] == 20
+
+
+def test_no_padding_when_pad_to_length_none():
+    """Backward-compatible: without pad_to_length, length == real length."""
+    batch = _build(body_len=33, pad_to_length=None)
+    assert batch["tokens"].shape == (1, 33)
+    assert batch["n_real_tokens"] == 33
+
+
+def test_exact_length_is_noop():
+    batch = _build(body_len=128, pad_to_length=128)
+    assert batch["tokens"].shape == (1, 128)
+    assert batch["n_real_tokens"] == 128
+    assert torch.all(batch["tokens"][0] == 7)  # no pad tokens
+
+
+def test_over_length_raises():
+    """A pack longer than pad_to_length is a bug upstream — fail loudly."""
+    import pytest
+    with pytest.raises(ValueError, match="exceeds pad_to_length"):
+        _build(body_len=200, pad_to_length=128)
+

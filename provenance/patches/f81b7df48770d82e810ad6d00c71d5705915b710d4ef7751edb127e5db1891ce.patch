+-    keys = ['data_ms', 'mask_ms', 'fwd_ms', 'bwd_ms', 'opt_ms', 'wall_ms']
+-    sync_mean = {k: _mean_std([e[k] for e in sync_timings])[0] for k in keys}
+-    sync_std  = {k: _mean_std([e[k] for e in sync_timings])[1] for k in keys}

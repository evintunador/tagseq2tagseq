++#!/bin/bash
++#SBATCH --job-name=arxiv_extract
++#SBATCH --output=/fss-data/evin_t/tagseq2tagseq_artifacts/graphs/arxiv_extract_%j.log
++#SBATCH --nodes=1
++#SBATCH --ntasks=1
++#SBATCH --cpus-per-task=32
++#SBATCH --mem=128G
++#SBATCH --time=06:00:00
++#
++# Phase 2: extract the arXiv graph + rehydrated LaTeX content from unarXive 2024,
++# with OpenAlex-enriched citation resolution. CPU-only; reads/writes /fss-data
++# (per cluster-kb). Two passes over 12,937 shards + a merge pass.
++#
++# Usage: sbatch data/arxiv_graph_extractor/extract.sh
++
++set -euo pipefail
++
++REPO=/fss/evin_t/tagseq2tagseq
++CORPUS=/fss-data/evin_t/tagseq2tagseq_artifacts/raw/unarxive_2024/extracted/processed_unarxive_extended_data
++OA_MAP=/fss-data/evin_t/tagseq2tagseq_artifacts/graphs/arxiv_openalex_map.jsonl
++OUTDIR=/fss-data/evin_t/tagseq2tagseq_artifacts/graphs/arxiv
++
++cd "$REPO"
++source .venv/bin/activate
++
++mkdir -p "$OUTDIR"
++echo "[$(date)] Extracting arXiv graph+content ($SLURM_CPUS_PER_TASK workers, OpenAlex-enriched) ..."
++python -u data/arxiv_graph_extractor/extract.py \
++    --corpus-dir "$CORPUS" \
++    --out-dir "$OUTDIR" \
++    --oa-map "$OA_MAP" \
++    --workers "${SLURM_CPUS_PER_TASK:-8}"
++echo "[$(date)] DONE. graph.jsonl + content.jsonl in $OUTDIR"
++

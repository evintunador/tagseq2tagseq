++#!/bin/bash
++#SBATCH --job-name=unarxive_dl
++#SBATCH --output=/fss-data/evin_t/tagseq2tagseq_artifacts/raw/unarxive_dl_%j.log
++#SBATCH --nodes=1
++#SBATCH --ntasks=1
++#SBATCH --cpus-per-task=8
++#SBATCH --time=12:00:00
++#
++# Download unarXive 2024 (ines-besrour/unarxive_2024) to /fss-data and stream-extract.
++#
++# Why SLURM + /fss-data (per cluster-kb skill):
++#   - 105 GB download is heavy I/O; must NOT run on a login node.
++#   - Extraction produces millions of small files; must NOT touch /fss.
++#   - /fss-data (NFS 172.16.6.40) is the dedicated bulk/high-frequency-write filesystem.
++#
++# Dataset layout on HF: one .tar.gz split into raw byte parts:
++#   unarXive_2024.tar.gz.part_aa  (~40 GB)
++#   unarXive_2024.tar.gz.part_ab  (~40 GB)
++#   unarXive_2024.tar.gz.part_ac  (~25 GB)
++# Reassembly = `cat part_* | tar xz` (stream-extract; no 105 GB intermediate).
++#
++# Resumable: hf download resumes partial part files; set FORCE_REEXTRACT=1 to redo extraction.
++#
++# Usage:
++#   sbatch data/download_unarxive.sh
++# Token: read from ~/.secrets (HUGGINGFACE_API_KEY); never echoed.
++
++set -euo pipefail
++
++DEST=/fss-data/evin_t/tagseq2tagseq_artifacts/raw/unarxive_2024
++PARTS_DIR="$DEST/parts"
++EXTRACT_DIR="$DEST/extracted"
++REPO=ines-besrour/unarxive_2024
++
++mkdir -p "$PARTS_DIR" "$EXTRACT_DIR"
++
++# --- auth (no echo) ---
++set +x
++source ~/.secrets 2>/dev/null || { echo "ERROR: ~/.secrets not found"; exit 1; }
++export HF_TOKEN="${HUGGINGFACE_API_KEY:?HUGGINGFACE_API_KEY not set in ~/.secrets}"
++# Keep HF's own cache off /fss too:
++export HF_HOME="$DEST/.hf_home"
++mkdir -p "$HF_HOME"
++
++echo "[$(date)] Downloading unarXive 2024 parts to $PARTS_DIR ..."
++# Download only the 3 tar parts (skip the 105GB-equivalent nothing else needed).
++for part in part_aa part_ab part_ac; do
++  echo "[$(date)] -> unarXive_2024.tar.gz.$part"
++  hf download "$REPO" "unarXive_2024.tar.gz.$part" \
++      --repo-type dataset \
++      --local-dir "$PARTS_DIR"
++done
++
++echo "[$(date)] Download complete. Parts on disk:"
++ls -la "$PARTS_DIR"/unarXive_2024.tar.gz.part_* 2>/dev/null || true
++
++# --- stream-extract (cat parts | tar xz), no intermediate concat file ---
++SENTINEL="$EXTRACT_DIR/.extract_complete"
++if [[ -f "$SENTINEL" && "${FORCE_REEXTRACT:-0}" != "1" ]]; then
++  echo "[$(date)] Extraction already complete ($SENTINEL). Set FORCE_REEXTRACT=1 to redo."
++else
++  echo "[$(date)] Stream-extracting into $EXTRACT_DIR ..."
++  cat "$PARTS_DIR"/unarXive_2024.tar.gz.part_a? | tar -xzf - -C "$EXTRACT_DIR"
++  touch "$SENTINEL"
++  echo "[$(date)] Extraction complete."
++fi
++
++echo "[$(date)] Top-level extracted contents:"
++ls -la "$EXTRACT_DIR" | head -30
++echo "[$(date)] DONE."
++
+

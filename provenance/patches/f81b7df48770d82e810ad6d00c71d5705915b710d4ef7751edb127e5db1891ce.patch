+-                        f"wall={entry['wall_ms']:.0f}ms  "
+-                        f"fwd={entry['fwd_ms']:.0f}ms  "
+-                        f"bwd={entry['bwd_ms']:.0f}ms  "
+-                        f"opt={entry['opt_ms']:.0f}ms",
+-                        flush=True,
+-                    )

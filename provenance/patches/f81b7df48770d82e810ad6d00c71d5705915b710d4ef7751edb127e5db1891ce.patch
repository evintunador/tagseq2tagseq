++MT=$P/merged_all_v2/splits/train
++cd /fss/evin_t/tagseq2tagseq
++
++OUT="$1"; shift
++declare -A T
++T[wiki]="$1"; T[stack]="$2"; T[arxiv]="$3"; T[go]="$4"; T[java]="$5"
++T[typescript]="$6"; T[kotlin]="$7"; T[rust]="$8"; T[javascript]="$9"; T[zig]="${10}"; T[dart]="${11}"
++
++python -m data.merge_packs \

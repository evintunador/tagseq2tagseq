++++ b/scripts/monitor_training.sh
+@@ -0,0 +1,51 @@
++#!/bin/bash
++# One-shot status of the in-progress down-node training jobs + the wiki-merge
++# finalize watcher. Reads logs only (cheap); does not ssh unless --gpu is passed.
++#
++# Usage: monitor_training.sh [--gpu]
++set -uo pipefail
++PLOG=/fss-data/evin_t/tagseq2tagseq_artifacts/pipeline_logs
++R=/fss/evin_t/tagseq2tagseq/runs
++
++# tag | node | config | run_dir
++JOBS=(
++  "dc269|GPU-269|thestack_doc_causal|20260630_193825"
++  "dcc694|GPU-694|thestack_doc_concatenated|20260630_194919"
++  "tsdclink269|GPU-269|thestack_doc_concat_link|20260702_010558"
++  "arxdc269|GPU-269|arxiv_doc_causal|20260701_170244"
++  "arxdcc694|GPU-694|arxiv_doc_concatenated|20260701_170434"
++  "arxcdl_resume|GPU-423|arxiv_cross_doc|20260702_224836"
++  "arxdclink_resume|GPU-423|arxiv_doc_concat_link|20260702_230538"
++)
++
++printf "%-14s %-8s %-26s %-10s %-14s %s\n" TAG NODE CONFIG STEP "LOSS" STATUS
++for j in "${JOBS[@]}"; do
++  IFS='|' read -r tag node cfg run <<< "$j"
++  L=$(ls "$PLOG"/downnode_${tag}_GPU-*.log 2>/dev/null | head -1)
++  last=$(tr '\r' '\n' < "$L" 2>/dev/null | grep -oE "Training: [0-9]+it \[[^]]*loss=[0-9.]+\]" | tail -1)
++  step=$(grep -oE "Training: [0-9]+it" <<< "$last" | grep -oE "[0-9]+")
++  loss=$(grep -oE "loss=[0-9.]+" <<< "$last" | grep -oE "[0-9.]+$")
++  # done markers / errors
++  status="running"
++  # "Training complete"/"max_optimizer_steps reached" are true terminal markers;
++  # do NOT match "Eval results written" — a resume runs an eval pass BEFORE
++  # training, which would false-positive as DONE.
++  if tr '\r' '\n' < "$L" 2>/dev/null | grep -qiE "Training complete|max_optimizer_steps reached"; then status="DONE"; fi
++  if tr '\r' '\n' < "$L" 2>/dev/null | tail -200 | grep -qiE "traceback|CUDA error|out of memory|NCCL.*timeout|ChildFailedError"; then status="ERROR?"; fi
++  ck=$R/$run/checkpoints/best_model.pt
++  ckage=$([ -f "$ck" ] && echo "ck $(( ( $(date +%s) - $(stat -c%Y "$ck") ) / 60 ))m" || echo "no-ck")
++  printf "%-14s %-8s %-26s %-10s %-14s %s %s\n" "$tag" "$node" "$cfg" "${step:-?}" "${loss:-?}" "$status" "$ckage"
++done
++
++echo
++echo "--- wiki merge finalize watcher ---"
++tail -1 "$PLOG"/../wiki_multi/logs/_finalize.log 2>/dev/null || echo "(no finalize log)"
++
++if [ "${1:-}" = "--gpu" ]; then
++  echo
++  for N in GPU-269 GPU-423 GPU-694; do
++    echo "--- $N GPUs ---"
++    ssh -o BatchMode=yes -o ConnectTimeout=8 "$N" 'nvidia-smi --query-gpu=index,utilization.gpu,memory.used --format=csv,noheader' 2>&1 | paste -sd' | '
++  done
++fi
++
+
+diff --git a/scripts/wiki_dump_pipeline.sh b/scripts/wiki_dump_pipeline.sh

+-                    bwd_ms=   e_fwd_end.elapsed_time(e_bwd_end),
+-                    opt_ms=   e_bwd_end.elapsed_time(e_opt_end),
+-                    wall_ms=  (t_step_end   - t_step_start) * 1000,
+-                )

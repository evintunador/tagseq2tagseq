++def test_hardlink_shares_inode(tmp_path):
++    """hardlink mode must not copy bytes: merged shard shares the source inode."""
++    a = tmp_path / "a"
++    _write_dataset(a, {"a1": [1, 2, 3]})
++    out = tmp_path / "merged"
++    merge_datasets(inputs=[("dsa", a)], output_dir=out,

++#!/bin/bash
++# Generalized: watch a node's thestack job; when it completes (frees GPUs 0-3),
++# STAGGER-upgrade that node's arxiv job (2→4 GPU) and, if present & still running,
++# its doc_concat_link job (1→2 GPU). Both keep 262144 tok/step (packs/step stays 8)
++# so max_optimizer_steps is unchanged; both resume from checkpoint.
++#
++# Usage:
++#   watch_upgrade_node.sh <NODE> <TS_TAG> <ARX_TAG> <ARX_CONFIG> <ARX_MAXSTEPS> \
++#                         [<DCL_TAG> <DCL_CONFIG> <DCL_MAXSTEPS>]
++# The DCL_* args are optional — omit to skip the doc_concat_link upgrade
++# (e.g. GPU-694 whose dclink is the already-finished wiki job).
++set -uo pipefail
++NODE=$1; TS_TAG=$2; ARX_TAG=$3; ARX_CFG=$4; ARX_MAX=$5
++DCL_TAG=${6:-}; DCL_CFG=${7:-}; DCL_MAX=${8:-}
++REPO=/fss/evin_t/tagseq2tagseq
++PLOG=/fss-data/evin_t/tagseq2tagseq_artifacts/pipeline_logs
++TS_LOG=$PLOG/downnode_${TS_TAG}_${NODE}.log
++ARX_LOG=$PLOG/downnode_${ARX_TAG}_${NODE}.log
++
++rd_of() { grep -oE "runs/[0-9_]+" "$1" 2>/dev/null | head -1; }
++wait_step1() {  # wait until log $1 shows any training step (or done marker)
++  while true; do
++    grep -qiE "Training complete|Eval results written|max_optimizer_steps reached" "$1" 2>/dev/null && return 0
++    local s=$(tr '\r' '\n' < "$1" 2>/dev/null | grep -oE 'Training: [0-9]+it' | tail -1 | grep -oE '[0-9]+')
++    [ -n "$s" ] && [ "$s" -ge 1 ] && return 0
++    sleep 60
++  done
++}
++
++echo "[upg $NODE] waiting for thestack $TS_TAG >= 27488 ..."
++while true; do
++  grep -qiE "Training complete|Eval results written|max_optimizer_steps reached" "$TS_LOG" 2>/dev/null && { echo "[upg $NODE] done marker"; break; }
++  step=$(tr '\r' '\n' < "$TS_LOG" 2>/dev/null | grep -oE 'Training: [0-9]+it' | tail -1 | grep -oE '[0-9]+')
++  [ -n "$step" ] && [ "$step" -ge 27488 ] && { echo "[upg $NODE] step $step >= 27488"; break; }
++  sleep 120
++done
++echo "[upg $NODE] thestack $TS_TAG finished $(date). Upgrading."
++sleep 30
++
++ARX_RD=$(rd_of "$ARX_LOG"); ARX_CK=$REPO/$ARX_RD/checkpoints/best_model.pt
++[ -f "$ARX_CK" ] || { echo "[upg $NODE] ERROR: no arxiv ckpt ($ARX_CK); abort"; exit 1; }
++
++DCL_RD=""; DCL_CK=""
++if [ -n "$DCL_TAG" ]; then
++  DCL_LOG=$PLOG/downnode_${DCL_TAG}_${NODE}.log
++  DCL_RD=$(rd_of "$DCL_LOG"); DCL_CK=$REPO/$DCL_RD/checkpoints/best_model.pt
++  # only upgrade dclink if it's still running (has a live proc) and has a ckpt
++  if ! ssh -o BatchMode=yes $NODE "pgrep -f '$DCL_TAG' >/dev/null" 2>/dev/null; then
++    echo "[upg $NODE] dclink $DCL_TAG not running (finished?) — skipping its upgrade"; DCL_TAG=""
++  elif [ ! -f "$DCL_CK" ]; then
++    echo "[upg $NODE] dclink $DCL_TAG has no ckpt — skipping its upgrade"; DCL_TAG=""
++  fi
++fi
++
++# kill old arxiv (+dclink if upgrading) by run-tag match
++ssh -o BatchMode=yes $NODE "
++  for tag in $ARX_TAG ${DCL_TAG:-__none__}; do
++    for p in \$(nvidia-smi --query-compute-apps=pid --format=csv,noheader); do
++      tr '\0' ' ' < /proc/\$p/cmdline 2>/dev/null | grep -q \"\$tag\" && kill -9 \$p 2>/dev/null
++    done
++    pkill -9 -f \"\$tag\" 2>/dev/null
++  done
++  sleep 6
++  echo '[upg $NODE] post-kill mem:' \$(nvidia-smi --query-gpu=index,memory.used --format=csv,noheader | paste -sd' | ' -)
++" 2>&1
++sleep 10
++
++# STAGGER 1: arxiv → 4 GPU (0,1,2,3) accum2
++echo "[upg $NODE] launch arxiv $ARX_TAG 4-GPU (resume)"
++ssh -o BatchMode=yes $NODE "$REPO/launch_downnode.sh $ARX_CFG ${ARX_TAG}_4gpu 0,1,2,3 2 $ARX_MAX --resume-from $ARX_RD/checkpoints/best_model.pt" 2>&1
++echo "[upg $NODE] waiting for arxiv 4-GPU first step before staggering dclink..."
++wait_step1 "$PLOG/downnode_${ARX_TAG}_4gpu_${NODE}.log"
++
++# STAGGER 2: dclink → 2 GPU (4,5) accum4  (if applicable)
++if [ -n "$DCL_TAG" ]; then
++  echo "[upg $NODE] launch dclink $DCL_TAG 2-GPU (resume)"
++  ssh -o BatchMode=yes $NODE "$REPO/launch_downnode.sh $DCL_CFG ${DCL_TAG}_2gpu 4,5 4 $DCL_MAX --resume-from $DCL_RD/checkpoints/best_model.pt" 2>&1
++fi
++echo "[upg $NODE] UPGRADES DONE $(date). arxiv=4GPU$( [ -n "$DCL_TAG" ] && echo ', dclink=2GPU')."
++
+


+-    run_dir = Path(__file__).parent / "runs" / run_id
+-
+-    dist_mgr = DistributedManager()
+-    rep = ReproducibilityManager(
+-        output_dir=str(run_dir),
+-        is_main_process=dist_mgr.is_main,
+-    )
+-    with dist_mgr, rep:
+-        main(cfg, dist_mgr, rep)

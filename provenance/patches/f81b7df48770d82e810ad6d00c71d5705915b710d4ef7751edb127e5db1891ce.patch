++    b = tmp_path / "b"
++    _write_dataset(a, {"a1": [1]}, dtype_str="uint16")
++    _write_dataset(b, {"b1": [2]}, dtype_str="uint32")
++    with pytest.raises(ValueError, match="dtype"):
++        merge_datasets(inputs=[("dsa", a), ("dsb", b)],

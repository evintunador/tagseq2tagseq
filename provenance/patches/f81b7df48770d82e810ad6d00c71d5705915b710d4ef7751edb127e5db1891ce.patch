++def test_training_module_padding_ignored_in_loss(device, dtype):
++    """A right-padded batch must yield the same loss as the unpadded equivalent.
++
++    Fixed-length padding (n_real_tokens) keeps the Triton kernel's constexpr N
++    constant; the padded TARGET positions must be masked to ignore_index so they
++    contribute nothing. We verify by comparing the loss of a real sequence to the
++    same sequence padded out to a longer fixed length — they must match, proving
++    the pad region is fully ignored.
++    """
++    if device != 'cuda':
++        pytest.skip("FlexAttention requires CUDA")
++
++    vocab_size = 1024
++    real_len = 64          # real input length (tokens = real_len + 1)
++    padded_len = 128       # fixed pack length after padding
++    module = TS2TSTrainingModule.from_config(
++        block_mask_creator=simple_block_mask_creator,
++        vocab_size=vocab_size,
++        num_layers=2,
++        model_dim=256,
++        num_heads=4,
++        max_seq_len=padded_len,
++        drop_path_rate=0.0,
++        fp8=False,
++        weight_tying=True,
++        dtype=torch.bfloat16,
++    ).to(device, torch.bfloat16)
++    module.eval()  # disable MTP/dropout for a clean comparison
++
++    torch.manual_seed(0)

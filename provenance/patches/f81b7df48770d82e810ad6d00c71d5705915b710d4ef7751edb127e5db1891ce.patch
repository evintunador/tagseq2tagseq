+index 0000000..1234567
+--- /dev/null
++++ b/data/arxiv_graph_extractor/build_openalex_map.sh
+@@ -0,0 +1,29 @@
++#!/bin/bash
++#SBATCH --job-name=oa_map
++#SBATCH --output=/fss-data/evin_t/tagseq2tagseq_artifacts/graphs/oa_map_%j.log
++#SBATCH --nodes=1
++#SBATCH --ntasks=1
++#SBATCH --cpus-per-task=32
++#SBATCH --mem=64G
++#SBATCH --time=08:00:00
++#
++# Phase 1: build the arXiv <-> OpenAlex id map by streaming the OpenAlex works
++# snapshot (~639 GB gzip, 2127 parts) directly from S3. No bulk download to disk —
++# only the small id map is written to /fss-data. CPU + network bound; per cluster-kb.
++#
++# Usage: sbatch data/arxiv_graph_extractor/build_openalex_map.sh
++
++set -euo pipefail
++
++REPO=/fss/evin_t/tagseq2tagseq
++OUT=/fss-data/evin_t/tagseq2tagseq_artifacts/graphs/arxiv_openalex_map.jsonl
++
++cd "$REPO"
++source .venv/bin/activate
++
++echo "[$(date)] Building arXiv<->OpenAlex map ($SLURM_CPUS_PER_TASK workers, streaming from S3) ..."
++python -u data/arxiv_graph_extractor/build_openalex_map.py \
++    --out "$OUT" \
++    --workers "${SLURM_CPUS_PER_TASK:-8}"
++echo "[$(date)] DONE. Map at $OUT"
++

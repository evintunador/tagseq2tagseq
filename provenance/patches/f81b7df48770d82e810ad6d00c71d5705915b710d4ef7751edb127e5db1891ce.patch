++#!/bin/bash
++# LR-sweep courtesy watcher.
++#
++# Watches the SLURM queue for OTHER users' jobs stuck PENDING (waiting in line for
++# nodes). When someone is blocked, it frees nodes by cancelling our lowest-priority
++# sweep jobs (named ts2ts_*), youngest-first (least training lost — all runs
++# checkpoint latest.pt every 250 steps and are --resume-from resumable).
++#
++# The user (evin_t) explicitly authorized auto-kill: "do not hesitate to kill if
++# somebody's waiting in line." This is a personal, non-urgent project.
++#
++# Notifies via a log + a NOTIFY file the user can tail. Does NOT touch other users'
++# jobs. Only ever cancels jobs named ts2ts_* owned by $ME.
++#
++# Usage:  nohup scripts/sweep_yield_watcher.sh >> <log> 2>&1 &
++# Env:    POLL_SECS (default 120), JOB_NAME_PREFIX (default ts2ts_),
++#         KILL_PER_TRIGGER (default 1 = free one node per waiting episode).
++set -uo pipefail
++
++ME="${USER:-evin_t}"
++POLL_SECS="${POLL_SECS:-120}"
++PREFIX="${JOB_NAME_PREFIX:-ts2ts_}"
++KILL_PER_TRIGGER="${KILL_PER_TRIGGER:-1}"
++NOTIFY="/fss-data/evin_t/tagseq2tagseq_artifacts/pipeline_logs/SWEEP_YIELD_NOTIFY.log"
++mkdir -p "$(dirname "$NOTIFY")"
++
++ts() { date '+%Y-%m-%d %H:%M:%S'; }
++note() { echo "[$(ts)] $*"; echo "[$(ts)] $*" >> "$NOTIFY"; }
++
++note "yield-watcher started (me=$ME, poll=${POLL_SECS}s, prefix=$PREFIX, kill/trigger=$KILL_PER_TRIGGER)"
++
++while true; do
++  # Other users' jobs that are PENDING and blocked on node availability.
++  # REASON values that mean "waiting for nodes": Resources, Priority.
++  waiting=$(squeue -h -t PENDING -o "%u|%r|%i" 2>/dev/null \
++            | awk -F'|' -v me="$ME" '$1!=me && ($2=="Resources"||$2=="Priority"){print $1"("$3":"$2")"}')
++
++  if [ -n "$waiting" ]; then
++    note "SOMEONE IS WAITING IN LINE: $(echo "$waiting" | tr '\n' ' ')"
++    # Our still-running sweep jobs, YOUNGEST first (smallest elapsed = least lost).
++    # squeue %M is elapsed; sort ascending by a parsed second count.
++    mine=$(squeue -h -u "$ME" -t RUNNING -o "%i|%j|%M|%N" 2>/dev/null \
++           | awk -F'|' -v p="$PREFIX" 'index($2,p)==1{print}')
++    if [ -z "$mine" ]; then
++      note "  ...but I have no running $PREFIX jobs to cancel. Nothing to yield."
++    else
++      # convert elapsed (D-HH:MM:SS | HH:MM:SS | MM:SS) to seconds, sort youngest first
++      ranked=$(echo "$mine" | while IFS='|' read -r jid jname elapsed nodes; do
++        secs=$(echo "$elapsed" | awk -F'[-:]' '{
++          if (NF==4) print (($1*24+$2)*60+$3)*60+$4;
++          else if (NF==3) print (($1*60)+$2)*60+$3;
++          else if (NF==2) print ($1*60)+$2;
++          else print $1 }')
++        echo "$secs|$jid|$nodes|$elapsed"
++      done | sort -n)
++      killed=0
++      while IFS='|' read -r secs jid nodes elapsed && [ "$killed" -lt "$KILL_PER_TRIGGER" ]; do
++        [ -z "$jid" ] && continue
++        note "  CANCELLING sweep job $jid on $nodes (elapsed $elapsed) to free a node. Resumable from latest.pt."
++        scancel "$jid" 2>/dev/null && killed=$((killed+1))
++      done <<< "$ranked"
++      note "  yielded $killed node(s). Remaining sweep jobs: $(squeue -h -u "$ME" -t RUNNING -o '%i' | tr '\n' ' ')"
++    fi
++    # back off longer after a kill so the coworker's job can actually schedule
++    sleep $(( POLL_SECS * 3 ))
++  fi
++
++  sleep "$POLL_SECS"
++done
++
+


++#!/bin/bash
++# Watch thestack cross_doc (GPU-423). When it completes (frees GPUs 0-3), upgrade
++# BOTH arxiv jobs on that node to use the freed GPUs, STAGGERED (CLAUDE.md rule:
++# never launch jobs simultaneously — concurrent cold-compile deadlocks + run-dir
++# second-collision):
++#   arxiv_cross_doc: 2 GPU (4,5) accum4  →  4 GPU (0,1,2,3) accum2   (~2x faster)
++#   dclink_arxiv:    1 GPU (6)   accum8  →  2 GPU (4,5)     accum4   (~2x faster)
++# Both keep 262144 tok/step, packs/step unchanged (8), so max_optimizer_steps is
++# unchanged and main.py's resume-step subtraction is exact. GPU 6 ends up spare.
++set -uo pipefail
++NODE=GPU-423
++REPO=/fss/evin_t/tagseq2tagseq
++PLOG=/fss-data/evin_t/tagseq2tagseq_artifacts/pipeline_logs
++TS_LOG=$PLOG/downnode_cdl423_GPU-423.log
++ARX_LOG=$PLOG/downnode_arxcdl423_GPU-423.log
++DCL_LOG=$PLOG/downnode_arxdclink423_GPU-423.log
++
++wait_step() {  # $1=log $2=target ; returns when log hits target step or a done marker
++  while true; do
++    if grep -qiE "Training complete|Eval results written|max_optimizer_steps reached" "$1" 2>/dev/null; then return 0; fi
++    local s=$(tr '\r' '\n' < "$1" 2>/dev/null | grep -oE 'Training: [0-9]+it' | tail -1 | grep -oE '[0-9]+')
++    [ -n "$s" ] && [ "$s" -ge "$2" ] && return 0
++    sleep 60
++  done
++}
++
++echo "[watch] waiting for thestack cross_doc >= 27488 (poll 120s)..."
++while true; do
++  if grep -qiE "Training complete|Eval results written|max_optimizer_steps reached" "$TS_LOG" 2>/dev/null; then echo "[watch] DONE marker"; break; fi
++  step=$(tr '\r' '\n' < "$TS_LOG" 2>/dev/null | grep -oE 'Training: [0-9]+it' | tail -1 | grep -oE '[0-9]+')
++  [ -n "$step" ] && [ "$step" -ge 27488 ] && { echo "[watch] step $step >= 27488"; break; }
++  sleep 120
++done
++echo "[watch] thestack cross_doc finished at $(date). Upgrading arxiv jobs on $NODE."
++sleep 30   # let thestack release GPUs 0-3
++
++ARX_RD=$(grep -oE "runs/[0-9_]+" "$ARX_LOG" 2>/dev/null | head -1)
++DCL_RD=$(grep -oE "runs/[0-9_]+" "$DCL_LOG" 2>/dev/null | head -1)
++ARX_CK=$REPO/$ARX_RD/checkpoints/best_model.pt
++DCL_CK=$REPO/$DCL_RD/checkpoints/best_model.pt
++echo "[watch] arxiv ckpt=$ARX_CK  dclink ckpt=$DCL_CK"
++[ -f "$ARX_CK" ] || { echo "[watch] ERROR: no arxiv_cross_doc ckpt; abort"; exit 1; }
++[ -f "$DCL_CK" ] || { echo "[watch] ERROR: no dclink_arxiv ckpt; abort"; exit 1; }
++
++# --- kill BOTH old arxiv jobs on this node (match by run tag in cmdline) ---
++ssh -o BatchMode=yes $NODE '
++  for tag in arxcdl423 arxdclink423; do
++    for p in $(nvidia-smi --query-compute-apps=pid --format=csv,noheader); do
++      if tr "\0" " " < /proc/$p/cmdline 2>/dev/null | grep -q "$tag"; then kill -9 $p 2>/dev/null; fi
++    done
++    pkill -9 -f "$tag" 2>/dev/null
++  done
++  sleep 6
++  echo "[watch] post-kill GPU mem: $(nvidia-smi --query-gpu=index,memory.used --format=csv,noheader | paste -sd" | " -)"
++' 2>&1
++sleep 10
++
++# --- STAGGER 1: arxiv_cross_doc on 4 GPUs (0,1,2,3) accum2 ---
++echo "[watch] launching arxiv_cross_doc 4-GPU (resume)"
++ssh -o BatchMode=yes $NODE "$REPO/launch_downnode.sh configs/arxiv_cross_doc.yaml arxcdl423_4gpu 0,1,2,3 2 84472 --resume-from $ARX_RD/checkpoints/best_model.pt" 2>&1
++NEW_ARX_LOG=$PLOG/downnode_arxcdl423_4gpu_GPU-423.log
++echo "[watch] waiting for arxiv_cross_doc 4-GPU to reach first training step before staggering dclink..."
++wait_step "$NEW_ARX_LOG" 1
++echo "[watch] arxiv_cross_doc 4-GPU is training. Now launching dclink upgrade."
++
++# --- STAGGER 2: dclink_arxiv on 2 GPUs (4,5) accum4 ---
++ssh -o BatchMode=yes $NODE "$REPO/launch_downnode.sh configs/arxiv_doc_concat_link.yaml arxdclink423_2gpu 4,5 4 84472 --resume-from $DCL_RD/checkpoints/best_model.pt" 2>&1
++echo "[watch] BOTH UPGRADES LAUNCHED on $NODE at $(date)."
++echo "[watch] new logs: downnode_arxcdl423_4gpu_GPU-423.log, downnode_arxdclink423_2gpu_GPU-423.log; GPU 6 now spare."
++

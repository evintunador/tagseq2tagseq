++#!/usr/bin/env bash
++# Smoke-test all four mask conditions on both datasets (8 jobs).
++#
++# Goal: confirm each condition TRAINS (no crash, no NaN loss, no pathological
++# slowdown) on the real compute graph. Per CLAUDE.md we keep compile/backend/
++# max_seq_len at production values and only shrink steps/val/eval — anything
++# else would silently test a different execution path.
++#
++# 2 GPUs per job (modest resource use; loss descends slower at the smaller
++# effective batch but that's fine for a smoke). thestack forces the LIVE data
++# path (--data.epoch_dirs '') because the existing precomputed epoch dirs
++# predate component_id, on which doc_concatenated would silently degenerate to
++# doc_causal.
++set -euo pipefail
++
++ART=/fss/evin_t/tagseq2tagseq_artifacts
++EXCLUDE="GPU-495,GPU-954,GPU-269,GPU-423,GPU-658,GPU-670"   # broken-NFS + down nodes
++
++# Shrunk-but-real smoke overrides. NOTE: model.compile, attention_backend, and
++# max_seq_len are deliberately left at config (production) values.
++COMMON=(
++  --gpus-per-node 2
++  --time 02:00:00
++  --no-tail
++  --exclude "$EXCLUDE"
++  --train_loop.max_optimizer_steps 20
++  --train_loop.val_steps 2
++  --train_loop.val_interval 10
++  --eval.run_on_completion false
++)
++
++launch_simplewiki () {
++  local cfg=$1
++  python launch_slurm.py "${COMMON[@]}" --config "configs/${cfg}.yaml" \
++    --data.dataset_dir "$ART/pretokenized_datasets/simplewiki" \
++    --data.train_dir   "$ART/pretokenized_datasets/simplewiki/splits/train" \
++    --data.val_dirs.val_community "$ART/pretokenized_datasets/simplewiki/splits/val_community" \
++    --data.val_dirs.val_random    "$ART/pretokenized_datasets/simplewiki/splits/val_random"
++}
++
++launch_thestack () {
++  local cfg=$1
++  # epoch_dirs '' forces the live PackBatchSampler path (generates component_id).
++  python launch_slurm.py "${COMMON[@]}" --config "configs/${cfg}.yaml" \
++    --data.dataset_dir "$ART/pretokenized_datasets/thestack" \
++    --data.train_dir   "$ART/pretokenized_datasets/thestack/splits/train" \
++    --data.epoch_dirs  '' \
++    --data.val_dirs.val_community "$ART/pretokenized_datasets/thestack/splits/val_community" \
++    --data.val_dirs.val_random    "$ART/pretokenized_datasets/thestack/splits/val_random"
++}
++
++echo "=== simplewiki ==="
++launch_simplewiki simplewiki_doc_causal
++launch_simplewiki simplewiki_doc_concatenated
++launch_simplewiki simplewiki_cross_doc
++launch_simplewiki simplewiki_doc_concat_link
++
++echo "=== thestack ==="
++launch_thestack thestack_doc_causal
++launch_thestack thestack_doc_concatenated
++launch_thestack thestack_cross_doc
++launch_thestack thestack_doc_concat_link
++

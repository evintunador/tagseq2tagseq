+-            attention_backend = 'varlen_bim_v2'
+-            block_mask_creator = make_mask_creator_callable_from(create_doc_causal_triton_mask)
+-        else:
+-            attention_backend = 'flex'
+-            block_mask_creator = make_mask_creator_callable(mask_type)

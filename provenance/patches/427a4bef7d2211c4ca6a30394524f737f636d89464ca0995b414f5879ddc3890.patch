+  cooldown_frac: 0.4
+  min_lr_ratio: 0.1
+  val_steps: 20
+  val_interval: 100
+  atomic_feature_kwargs:
+    norm_clip_value: 1.0
+    accum_steps: 1
+
+seed: 42
+
+eval:
+  run_on_completion: true
+  benchmarks:
+    - {name: held_out_perplexity,       conditions: [baseline, experimental]}
+    - {name: community_pack_perplexity, conditions: [baseline, experimental]}
+    - {name: wiki_qa,            conditions: [doceval, annotated]}
+    - {name: hellaswag,          conditions: [doceval, annotated]}
+    - {name: boolq,              conditions: [doceval, annotated]}
+    - {name: openbookqa,         conditions: [doceval, annotated]}
+    - {name: hotpotqa,           conditions: [doceval]}
+    - {name: hotpotqa_cross_doc, conditions: [experimental]}
+  max_docs: 500
+  annotator_corpus: /fss-data/evin_t/tagseq2tagseq_artifacts/pretokenized_datasets/wiki_merged

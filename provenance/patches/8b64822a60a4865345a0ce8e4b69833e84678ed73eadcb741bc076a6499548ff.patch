+  muon_wd: 1.2
+  adamw_wd: 0.005
+  momentum: 0.95
+  muon_beta2: 0.95
+  beta1: 0.9
+  beta2: 0.95
+  muon_lr: 0.001
+  adamw_lr: 0.00001
+  muon_momentum_warmup_steps: 300

+
+
+def get_spec(name: str) -> LanguageSpec:
+    if name not in SPECS:
+        raise KeyError(
+            f"No LanguageSpec named {name!r}. Registered: {sorted(SPECS)}"
+        )
+    return SPECS[name]
+

+        pass
+
+    logging.getLogger("ts2ts.debug").debug(
+        "rank debug logging online: log=%s fault=%s dump_every=%ds pid=%d",
+        log_path, fault_path, dump_every, os.getpid(),
+    )
+    return log_path

+class _FixedPrefixLayout:
+    """Layout stub that adds a fixed, non-trimmable prefix to every doc.
+
+    Mirrors the real prefix-carrying layouts (identifier_prefix,
+    latex_comment_prefix, etc.) whose prefix tokens cannot be trimmed by
+    pack-level body truncation.
+    """
+
+    def __init__(self, prefix_len: int, suffix_len: int = 0) -> None:
+        self._pre = prefix_len
+        self._suf = suffix_len
+
+    def prefix_length(self, info) -> int:  # noqa: ARG002
+        return self._pre
+
+    def suffix_length(self, info) -> int:  # noqa: ARG002
+        return self._suf
+
+
+def _materialised_len(p, pre, suf):
+    """Tokens this placement contributes to the pack after decoration trimming."""
+    decoration = pre + suf
+    return max(0, decoration - p.decoration_trim) + p.effective_len
+
+
+def test_pack_truncation_is_a_hard_cap_with_prefixes():
+    """token_budget must be a HARD cap even when docs carry non-trimmable prefixes.
+
+    Regression for the multi-rank DDP hang (TODOS.md): the old
+    _apply_pack_truncation 'else' branch skipped a doc when
+    effective_len < overshoot < prefix+body+suffix, letting overshoot leak so
+    the pack shipped ABOVE token_budget.  An over-budget pack trips the RoPE
+    cos/sin cache assert (cos.size(0) >= seq_len) in the attention forward on
+    whichever DDP rank drew it; that exception unwinds into the end-of-run
+    barrier and hangs the whole job.
+
+    The fix trims layout decoration (via DocPlacement.decoration_trim) as a last
+    resort so the pack hits token_budget EXACTLY — keeping the doc and its full
+    body — instead of leaking over budget or dropping the doc.
+    """
+    # 6 docs, each body=20, prefix=10 → per-doc full=30, pack total=180.
+    # budget 95 → overshoot 85.  Tail trim: drop two whole docs (85→55→25); the
+    # third doc has full=30 > 25 but body=20 < 25 — the leak gap.  OLD code
+    # skipped it (pack shipped 120 > 95).  NEW code trims that doc by 25 tokens:
+    # decoration_trim=min(25,10)=10 and body_trim=15 → body 20→5, so the doc is
+    # KEPT (body 5) and the pack lands exactly at 95.
+    n_docs = 6
+    body, pre = 20, 10
+    graph = DummyGraph(
+        token_lens={i: body for i in range(n_docs)},
+        outgoing={i: [] for i in range(n_docs)},
+        incoming={i: [] for i in range(n_docs)},
+    )
+    token_budget = 95
+    sampler = PackBatchSampler(
+        graph=graph,
+        strategy_factory=lambda: RandomSelectionStrategy(),
+        token_budget=token_budget,
+        doc_budget=None,
+        overflow_policy="truncate",
+        doc_level_trim_side="tail",
+        pack_level_trim_side="tail",
+        seed=0,
+        layout_policy=_FixedPrefixLayout(prefix_len=pre),
+    )
+    placements = [
+        DocPlacement(doc_id=i, effective_len=body, truncated=False, doc_trim_side="tail")
+        for i in range(n_docs)
+    ]
+    total_tokens = sum(pre + p.effective_len for p in placements)  # 180
+    trimmed = sampler._apply_pack_truncation(placements, total_tokens=total_tokens)
+
+    # Hard-cap invariant: the materialised pack must never exceed token_budget,
+    # accounting for decoration trimming.
+    final_total = sum(_materialised_len(p, pre, 0) for p in trimmed)
+    assert final_total <= token_budget, (
+        f"pack shipped {final_total} tokens > budget {token_budget} — "
+        "overshoot leaked through pack truncation"
+    )
+    # Maximum-data-usage invariant: when the overshoot can be absorbed by body +
+    # decoration trims, the pack should fill the budget EXACTLY (no under-fill).
+    assert final_total == token_budget, (
+        f"pack under-filled at {final_total} < budget {token_budget} — "
+        "decoration trimming should fill exactly"
+    )
+    # The doc in the former 'leak gap' must be KEPT (not dropped), with body
+    # preserved as much as possible.
+    assert len(trimmed) == 4, f"expected 4 surviving docs, got {len(trimmed)}"
+    # No surviving doc may have a negative or impossible decoration_trim.
+    for p in trimmed:
+        assert 0 <= p.decoration_trim <= pre, p.decoration_trim
+
+

+class DistributedSyncDataLoader:
+    """Wraps a train loader so all DDP ranks stop iterating on the same step.
+
+    Root cause this fixes (TODOS.md "multi-rank DDP hangs"): each rank builds
+    its own ``PackedSequenceDataset`` from a rank-seeded ``PackBatchSampler``,
+    whose graph traversal yields a *finite, rank-dependent* number of packs.
+    With ``num_epochs=1`` the first rank to exhaust its sampler leaves the
+    training loop and proceeds to the end-of-run barrier, while the other ranks
+    are still mid-loop and block forever on the in-flight DDP gradient
+    all-reduce from their next ``backward()`` — an NCCL collective desync.
+
+    Fix (coordinated termination): before yielding each batch, all-reduce a
+    per-rank "do I still have a batch?" flag with ``MIN``.  As soon as *any*
+    rank's underlying iterator is exhausted, the reduced flag is 0 and *every*
+    rank stops on that same step — without yielding the orphan batch that a
+    rank which still had data would otherwise forward/backward alone.  Every
+    rank therefore performs an identical number of forward/backward passes, so
+    the collective sequence stays in lockstep.
+
+    CRITICAL — the flag exchange runs on the secondary **Gloo** process group
+    (``tunalab.distributed._CPU_GROUP``) with a CPU tensor, NOT the default NCCL
+    group.  An all-reduce on the NCCL group would interleave with DDP's
+    bucketed gradient all-reduces (issued asynchronously by autograd hooks),
+    desynchronising NCCL collective sequence numbers across ranks — the very
+    failure this class fixes.  This is the same reasoning behind ``cpu_barrier``
+    for checkpoint sync: keep control-plane collectives off the NCCL data plane.
+    Falls back to a CPU Gloo collective on the default group only if no
+    secondary group exists.
+
+    A no-op passthrough when not distributed (single process / CPU).
+    """
+
+    def __init__(self, loader, device) -> None:
+        self.loader = loader
+        self.device = device
+
+    def __iter__(self):
+        import tunalab.distributed as _td
+        it = iter(self.loader)
+        distributed = torch.distributed.is_available() and torch.distributed.is_initialized()
+        # Control-plane group: prefer the Gloo side-group so we never touch NCCL.
+        group = _td._CPU_GROUP if (distributed and _td._CPU_GROUP is not None) else None
+        _dbg = logger.isEnabledFor(logging.DEBUG)
+        _n = 0
+        while True:
+            try:
+                batch = next(it)
+                local_has = 1
+            except StopIteration:
+                batch = None
+                local_has = 0
+
+            if distributed:
+                # CPU tensor + Gloo group → fully decoupled from the NCCL
+                # gradient all-reduce stream. MIN: 1 only if EVERY rank still
+                # has a batch.
+                _n += 1
+                if _dbg:
+                    logger.debug("SyncLoader: flag_reduce #%d enter local_has=%d", _n, local_has)
+                flag = torch.tensor([local_has], dtype=torch.int32, device="cpu")
+                torch.distributed.all_reduce(
+                    flag, op=torch.distributed.ReduceOp.MIN, group=group
+                )
+                if _dbg:
+                    logger.debug("SyncLoader: flag_reduce #%d exit reduced=%d", _n, int(flag.item()))
+                if int(flag.item()) == 0:
+                    if local_has and _dbg:
+                        logger.debug(
+                            "DistributedSyncDataLoader: this rank still had a batch but "
+                            "another rank's loader is exhausted — stopping all ranks in lockstep."
+                        )
+                    return
+            elif local_has == 0:
+                return
+
+            yield batch
+
+    @property
+    def dataset(self):
+        return self.loader.dataset
+

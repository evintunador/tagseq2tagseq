+# wall-time (and call counts) per named phase across every mask build, so a
+# profiler can attribute step time to link-detection vs grant-bitmask vs BIM
+# construction.  Read/reset via mask_profile_snapshot() / mask_profile_reset().
+# ---------------------------------------------------------------------------
+_MASK_PROFILE_ON = os.environ.get("TS2TS_MASK_PROFILE", "").strip().lower() in ("1", "true", "yes")
+MASK_PROFILE_TIMES: "defaultdict[str, float]" = defaultdict(float)
+MASK_PROFILE_COUNTS: "defaultdict[str, int]" = defaultdict(int)
+

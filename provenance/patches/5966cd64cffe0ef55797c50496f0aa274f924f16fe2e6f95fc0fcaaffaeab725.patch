+#!/bin/bash
+# 2-GPU torchrun profiling run on free GPUs of a down-node, mirroring the real
+# training regime (triton kernels + compile + DDP + bucketed data).
+set -euo pipefail
+REPO=/fss/evin_t/tagseq2tagseq
+CONFIG="$1"; TAG="$2"; GPUS="$3"   # e.g. GPUS=4,5
+export PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"
+export TORCH_DIST_TIMEOUT_SECONDS=600
+export TORCHINDUCTOR_COMPILE_THREADS=1
+export TORCHINDUCTOR_USE_STATIC_CUDA_LAUNCHER=0
+export TS2TS_MASK_PROFILE=1   # enable intra-mask phase timing (link/grant/BIM)
+export CUDA_VISIBLE_DEVICES="$GPUS"
+SHARED=/tmp/ts2ts_profcache_${TAG}
+LOG=/fss-data/evin_t/tagseq2tagseq_artifacts/pipeline_logs/profile_${TAG}_$(hostname).log
+cd "$REPO"
+PORT=$(( 31000 + (RANDOM % 2000) ))
+cat > /tmp/profrank_${TAG}.sh <<INNER
+#!/bin/bash
+export TORCHINDUCTOR_CACHE_DIR=${SHARED}/inductor
+export TRITON_CACHE_DIR=${SHARED}/triton
+mkdir -p "\$TORCHINDUCTOR_CACHE_DIR" "\$TRITON_CACHE_DIR"
+export PYTHONUNBUFFERED=1
+export TS2TS_MASK_PROFILE=1
+exec ${REPO}/.venv/bin/python -u ${REPO}/profile_training.py "\$@"
+INNER
+chmod +x /tmp/profrank_${TAG}.sh
+nohup "$REPO/.venv/bin/torchrun" --standalone --nnodes=1 --nproc_per_node=2 --no-python \
+    --master_port=$PORT /tmp/profrank_${TAG}.sh \
+    --config "$CONFIG" \
+    --data.dataset_dir /fss-data/evin_t/tagseq2tagseq_artifacts/pretokenized_datasets/thestack/splits/train \
+    --data.epoch_dirs /fss-data/evin_t/tagseq2tagseq_artifacts/schedules/thestack_bfs/epoch_0 \
+    --model.max_seq_len 32768 \
+    --profile.warmup_steps 3 --profile.profile_steps 15 --profile.no_sync_steps 5 \
+    > "$LOG" 2>&1 &
+echo "PID=$! LOG=$LOG"
+

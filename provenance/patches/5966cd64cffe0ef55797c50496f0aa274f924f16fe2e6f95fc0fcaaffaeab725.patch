+@contextmanager
+def _mask_phase(name: str):
+    """Time a mask-build phase into MASK_PROFILE_* (no-op unless profiling on)."""
+    if not _MASK_PROFILE_ON:
+        yield
+        return
+    if torch.cuda.is_available():
+        torch.cuda.synchronize()
+    t0 = time.perf_counter()
+    try:
+        yield
+    finally:
+        if torch.cuda.is_available():
+            torch.cuda.synchronize()
+        MASK_PROFILE_TIMES[name] += time.perf_counter() - t0
+        MASK_PROFILE_COUNTS[name] += 1
+
+
+def mask_profile_snapshot() -> Dict[str, Dict[str, float]]:
+    """Return {phase: {'total_s': float, 'calls': int, 'mean_ms': float}}."""
+    out: Dict[str, Dict[str, float]] = {}
+    for k, total in MASK_PROFILE_TIMES.items():
+        n = MASK_PROFILE_COUNTS[k]
+        out[k] = {"total_s": total, "calls": n, "mean_ms": (total / n * 1e3) if n else 0.0}
+    return out
+
+
+def mask_profile_reset() -> None:
+    MASK_PROFILE_TIMES.clear()
+    MASK_PROFILE_COUNTS.clear()
+
 

+# twin at this exact budget is the interpretable metric.
+# Recipe is the EXACT small-single-source-run recipe (muon_lr=0.003/wd=0.1, VE-off,
+# 15k steps ≈ 3.9B tok @ world=8, max_grants=256) so this run is a clean compute-match
+# to the per-language sweeps — the ONLY variable vs those runs is corpus DIVERSITY.
+# Packs are WITHIN-source (precomputed per source, balanced equal-ish + re-bucketed by
+# data/merge_packs.py); each pack carries its own layout_name so one BucketedPackDataset
+# decorates arxiv with the latex card and the rest with identifier/slash-comment cards.
+data:
+  dataset_dir: /fss-data/evin_t/tagseq2tagseq_artifacts/pretokenized_datasets/merged_all_v2
+  strategy: 'bfs'
+  layout_policy: 'stochastic_identifier_prefix'   # default/fallback; per-pack layout_name overrides
+  inference_layout_policy: 'identifier_prefix_eos'
+  order_mode: 'prefer_targets_first'
+  doc_budget: null
+  train_dir:   /fss-data/evin_t/tagseq2tagseq_artifacts/pretokenized_datasets/merged_all_v2/splits/train
+  epoch_dirs:  /fss-data/evin_t/tagseq2tagseq_artifacts/pretokenized_datasets/merged_all_v2/epoch_3p9b
+
+  # Per-source val: kept SEPARATE (not merged) for a per-link-type signal. Precomputed
+  # (not live) so packs carry baked per-source links + layout_name — correct regardless
+  # of the model's single config detector. val_dirs supplies each loader's graph;
+  # val_epoch_dirs supplies its packs (doc_ids index into that source's val graph).
+  val_dirs:
+    wiki_community:       /fss-data/evin_t/tagseq2tagseq_artifacts/pretokenized_datasets/wiki_merged/splits/val_community
+    wiki_random:          /fss-data/evin_t/tagseq2tagseq_artifacts/pretokenized_datasets/wiki_merged/splits/val_random
+    stack_community:      /fss-data/evin_t/tagseq2tagseq_artifacts/pretokenized_datasets/thestack/splits/val_community

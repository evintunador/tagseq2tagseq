+    # detector-free general NLP sanity
+    - {name: hellaswag,           conditions: [doceval]}
+    - {name: boolq,               conditions: [doceval]}
+    - {name: openbookqa,          conditions: [doceval]}
+  max_docs: 500
+  annotator_corpus: /fss-data/evin_t/tagseq2tagseq_artifacts/pretokenized_datasets/wiki_merged
+  annotator_mode: corpus_only
+  annotator_strategies: [exact, norm, word_overlap_ordered]
+  link_fuzzy_match: true
+  link_fuzzy_strategies: [exact, norm, word_overlap_ordered, edit_distance]
+  link_ed_threshold: 0.2
+
+# --- Smoke-test overrides (pass on CLI, don't edit here) ---
